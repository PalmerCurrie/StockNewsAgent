# Copy to `.env` and fill in. `.env` is gitignored and loaded at startup.
# Real environment variables always win over this file.

# --- Required --------------------------------------------------------------

# One LLM key. Anthropic is the default provider.
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ...or use OpenAI instead: set `llm_provider: openai` and an OpenAI
# `llm_model` in config.yaml, then supply this instead of the key above.
#   https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# --- Delivery: at least one channel ----------------------------------------

# Telegram. Talk to @BotFather for the token, then message your own bot and
# read the chat id out of https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
# DISCORD_WEBHOOK_URL=

# Email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TO=

# --- Optional --------------------------------------------------------------

# Only when state_store.type is `redis` -- i.e. you run on a host with no
# persistent disk, such as a GitHub Actions runner. The default sqlite store
# needs nothing here. Requires `pip install redis`.
# STATE_STORE_REDIS_URL=

# Any config.yaml key can be overridden with AGENT_*.
# AGENT_IMPACT_THRESHOLD=8
# AGENT_LLM_MODEL=claude-sonnet-5
# AGENT_WATCHLIST_FILE=./watchlist.yaml

# Hold a finished alert until an exact wall-clock time, so delivery does not
# drift with however long the run took. Same as --deliver-at / --deliver-tz.
# AGENT_DELIVER_AT=08:00
# AGENT_DELIVER_TZ=America/New_York
