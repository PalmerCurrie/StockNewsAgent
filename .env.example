# Copy to `.env` and fill in. `.env` is gitignored and loaded at startup.
# Real environment variables win over this file, so it can never shadow a
# GitHub Actions secret.
#
# For the DEPLOYED agent these same names go in GitHub:
#   Settings -> Secrets and variables -> Actions -> New repository secret

# --- Required -------------------------------------------------------------

# LLM. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Watchlist. Internal integration token from notion.so/my-integrations,
# with your stocks database shared to it. Only needed when
# watchlist_source: notion.
NOTION_API_TOKEN=

# Which Notion database holds the watchlist. Not a secret -- it is useless
# without the token above -- but it is yours, so it is not committed to
# config.yaml. Copy it out of the database URL:
#   notion.so/<workspace>/<DATABASE_ID>?v=...
# Deployed, this goes in Actions -> Variables (not Secrets).
AGENT_NOTION_DATABASE_ID=

# Cross-run state. Free Upstash Redis database, rediss:// connection string.
# Required for GitHub Actions (runners have no persistent disk).
STATE_STORE_REDIS_URL=

# Delivery -- at least one channel must work. Telegram: talk to @BotFather for
# the token, then message your bot and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional -------------------------------------------------------------

# Only if you add these channels to config.yaml
# DISCORD_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TO=

# Only if you set llm_provider: openai
# OPENAI_API_KEY=

# --- Local-only convenience -----------------------------------------------
# Any config.yaml key can be overridden with AGENT_*. These let you run
# locally without Notion or Redis:
# AGENT_WATCHLIST_SOURCE=static
# AGENT_STATE_STORE_TYPE=sqlite
# AGENT_STATE_STORE_PATH=./agent_state.db
# AGENT_ACTIVE_HOURS_START=00:00
# AGENT_ACTIVE_HOURS_END=23:59

# Hold a live alert until an exact wall-clock time, so delivery does not drift
# with however long the run takes. Equivalent to --deliver-at / --deliver-tz.
# Deployed, these are passed as workflow_dispatch inputs instead. Leave unset
# to send as soon as the run finishes.
# AGENT_DELIVER_AT=08:00
# AGENT_DELIVER_TZ=America/Los_Angeles
